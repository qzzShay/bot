# Kopieren nach .env  (chmod 600 .env)  — niemals committen!

# API-Keys der Börse. Für Futures-Trading freischalten, Auszahlungen DEAKTIVIERT lassen,
# und den Key auf die IP deines VPS beschränken.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Nur für OKX / Bitget nötig:
EXCHANGE_API_PASSWORD=

# Sicherheitsschalter: Live-Orders auf einem ECHTEN Konto (sandbox: none) werden nur
# ausgeführt, wenn hier exakt dieser Wert steht.
CONFIRM_LIVE_TRADING=

# Optional: Telegram-Benachrichtigungen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
