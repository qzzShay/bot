[Unit]
Description=CryptoBot Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptobot
WorkingDirectory=/opt/cryptobot
ExecStart=/opt/cryptobot/.venv/bin/python -m bot run
Restart=always
RestartSec=15
TimeoutStopSec=60
KillSignal=SIGTERM
# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cryptobot/data

[Install]
WantedBy=multi-user.target
